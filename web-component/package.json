{
  "name": "date-time-combo-picker",
  "version": "2.0.0-snapshot",
  "description": "A combined date & time picker web component: a single field with one popup containing a calendar. The date-time format pattern drives which time parts are shown.",
  "license": "Apache-2.0",
  "author": "DateTimeComboPicker contributors",
  "keywords": [
    "vaadin",
    "web-component",
    "web components",
    "lit",
    "date-picker",
    "time-picker",
    "date-time-picker",
    "datetime",
    "calendar"
  ],
  "type": "module",
  "main": "dist/date-time-combo-picker.js",
  "module": "dist/date-time-combo-picker.js",
  "types": "dist/date-time-combo-picker.d.ts",
  "exports": {
    ".": "./dist/date-time-combo-picker.js",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "NOTICE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && node scripts/copy-vendor.mjs",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@open-wc/dedupe-mixin": "^1.4.0",
    "@vaadin/a11y-base": "~25.2.0",
    "@vaadin/component-base": "~25.2.0",
    "@vaadin/field-base": "~25.2.0",
    "@vaadin/input-container": "~25.2.0",
    "@vaadin/overlay": "~25.2.0",
    "@vaadin/vaadin-themable-mixin": "~25.2.0",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@vaadin/aura": "~25.2.0",
    "@vaadin/vaadin-lumo-styles": "~25.2.0",
    "@web/dev-server-esbuild": "^1.0.2",
    "@web/test-runner": "^0.19.0",
    "@web/test-runner-playwright": "^0.11.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
